{
  "openapi": "3.1.0",
  "info": {
    "title": "EMPEDIAcaptcha API",
    "version": "1.0.1",
    "description": "Management of EMPEDIAcaptcha domains, rules, and statistics. Token and content verification are documented in the SDK guides.",
    "contact": {
      "name": "urbanstudio GmbH",
      "email": "service@urbanstudio.de",
      "url": "https://urbanstudio.de"
    }
  },
  "servers": [
    {
      "url": "https://empedia.cloud"
    }
  ],
  "tags": [
    {
      "name": "EMPEDIAcaptcha (domains, rules, statistics)"
    }
  ],
  "paths": {
    "/api/captcha/sites": {
      "get": {
        "tags": [
          "EMPEDIAcaptcha (domains, rules, statistics)"
        ],
        "operationId": "captcha-sites-list",
        "summary": "EMPEDIAcaptcha domains",
        "description": "Lists the organization's domains (a registrable domain with all its subdomains) with site key, hosts, mode, status and the key figures of the last 30 days. The secret is never returned.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesListResponse"
                },
                "example": {
                  "success": true,
                  "sites": [
                    {
                      "id": "uuid",
                      "name": "urbanstudio.de",
                      "sitekey": "ek_site_…",
                      "hosts": [
                        "urbanstudio.de",
                        "*.urbanstudio.de"
                      ],
                      "mode": "balanced",
                      "status": "active",
                      "observe": false,
                      "ok_30d": 1234,
                      "rejected_30d": 56
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:read"
            ]
          },
          {
            "oauth2": [
              "captcha:read"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:read"
          ],
          "mode": "all"
        }
      },
      "post": {
        "tags": [
          "EMPEDIAcaptcha (domains, rules, statistics)"
        ],
        "operationId": "captcha-sites-create",
        "summary": "Create a domain",
        "description": "Creates a domain. All hosts must belong to the same registrable domain (`example.com`, `*.example.com`). The secret appears **only in this response**.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesCreateResponse"
                },
                "example": {
                  "success": true,
                  "site": {
                    "id": "uuid",
                    "sitekey": "ek_site_…"
                  },
                  "secret": "ek_secret_…"
                }
              }
            }
          },
          "400": {
            "description": "invalid_host / multiple_domains",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "site_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaSitesCreateRequest"
              },
              "example": {
                "name": "urbanstudio.de",
                "hosts": [
                  "urbanstudio.de",
                  "*.urbanstudio.de"
                ],
                "mode": "balanced"
              }
            }
          }
        }
      }
    },
    "/api/captcha/sites/bulk": {
      "post": {
        "tags": [
          "EMPEDIAcaptcha (domains, rules, statistics)"
        ],
        "operationId": "captcha-sites-bulk",
        "summary": "Create many domains at once",
        "description": "Creates up to 100 domains in one call (e.g. for agencies). Each entry is validated individually; the response (207) reports success or error per entry. Secrets appear only here.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesBulkResponse"
                },
                "example": {
                  "success": true,
                  "created": 2,
                  "results": [
                    {
                      "index": 0,
                      "ok": true,
                      "site": {
                        "id": "uuid",
                        "sitekey": "ek_site_…"
                      },
                      "secret": "ek_secret_…"
                    },
                    {
                      "index": 1,
                      "ok": false,
                      "error": "site_limit"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid_bulk",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaSitesBulkRequest"
              },
              "example": {
                "sites": [
                  {
                    "name": "kunde-a.de",
                    "hosts": [
                      "kunde-a.de",
                      "*.kunde-a.de"
                    ]
                  },
                  {
                    "name": "kunde-b.de",
                    "hosts": [
                      "kunde-b.de"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/captcha/sites/{id}": {
      "get": {
        "tags": [
          "EMPEDIAcaptcha (domains, rules, statistics)"
        ],
        "operationId": "captcha-sites-get",
        "summary": "Domain details",
        "description": "Settings of a domain including page protection and observe mode.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesGetResponse"
                },
                "example": {
                  "success": true,
                  "site": {
                    "id": "uuid",
                    "name": "urbanstudio.de",
                    "hosts": [
                      "urbanstudio.de"
                    ],
                    "mode": "balanced",
                    "observe": false,
                    "gate": {
                      "enabled": false,
                      "ttl_min": 60,
                      "skip": [
                        "/robots.txt"
                      ],
                      "crawlers": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:read"
            ]
          },
          {
            "oauth2": [
              "captcha:read"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:read"
          ],
          "mode": "all"
        }
      },
      "patch": {
        "tags": [
          "EMPEDIAcaptcha (domains, rules, statistics)"
        ],
        "operationId": "captcha-sites-update",
        "summary": "Update a domain",
        "description": "Changes name, hosts, mode, token lifetime, pausing, **observe mode** (`observe`: assess and count but never block) and page protection (`gate`). Every change appears in the activity log.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesUpdateResponse"
                },
                "example": {
                  "success": true,
                  "site": {
                    "id": "uuid",
                    "observe": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaSitesUpdateRequest"
              },
              "example": {
                "observe": true
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "EMPEDIAcaptcha (domains, rules, statistics)"
        ],
        "operationId": "captcha-sites-delete",
        "summary": "Delete a domain",
        "description": "Deletes the domain including keys, rules and statistics.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesDeleteResponse"
                },
