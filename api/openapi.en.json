          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        }
      }
