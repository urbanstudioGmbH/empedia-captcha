      "get": {
        "tags": [
          "EMPEDIAcaptcha (domains, rules, statistics)"
        ],
        "operationId": "captcha-sites-stats",
        "summary": "Domain statistics",
        "description": "Counters per day and metric (challenge, solved, verify_ok, rejected, verify_fail, form_allow/review/block, gate_view/pass, observed_block, form_observed).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "1–90, default 30",
            "schema": {
              "type": "integer"
