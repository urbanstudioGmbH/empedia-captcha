    "/api/captcha/sites/{id}/activity": {
      "get": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-activity",
        "summary": "Änderungsprotokoll",
        "description": "Wer hat wann was geändert (Anlegen, Einstellungen, Secret, Regeln). Ohne IP-Adressen und ohne Werte.",
