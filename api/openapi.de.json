          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "1–100",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Startposition",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesActivityResponse"
                },
                "example": {
                  "success": true,
                  "total": 2,
                  "activity": [
                    {
                      "action": "captcha.site_update",
                      "at": "2026-10-17T09:00:00Z",
                      "user": "Anna",
                      "via": "dashboard",
                      "fields": [
                        "observe"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:read"
            ]
          },
          {
            "oauth2": [
              "captcha:read"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:read"
          ],
          "mode": "all"
        }
      }
