{
  "openapi": "3.1.0",
  "info": {
    "title": "EMPEDIAcaptcha API",
    "version": "1.0.2",
    "description": "Verwaltung von EMPEDIAcaptcha-Domains, Regeln und Statistiken. Die Prüfung von Tokens und Inhalten ist in den SDK-Anleitungen beschrieben.",
    "contact": {
      "name": "urbanstudio GmbH",
      "email": "service@urbanstudio.de",
      "url": "https://urbanstudio.de"
    }
  },
  "servers": [
    {
      "url": "https://empedia.cloud"
    }
  ],
  "tags": [
    {
      "name": "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
    }
  ],
  "paths": {
    "/api/captcha/sites": {
      "get": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-list",
        "summary": "Domains von EMPEDIAcaptcha",
        "description": "Listet die Domains (registrierbare Domain mit allen Subdomains) der Organisation mit Schlüsseln (Site-Key), Hosts, Modus, Status und Kennzahlen der letzten 30 Tage. Das Secret wird nie geliefert.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesListResponse"
                },
                "example": {
                  "success": true,
                  "sites": [
                    {
                      "id": "uuid",
                      "name": "urbanstudio.de",
                      "sitekey": "ek_site_…",
                      "hosts": [
                        "urbanstudio.de",
                        "*.urbanstudio.de"
                      ],
                      "mode": "balanced",
                      "status": "active",
                      "observe": false,
                      "ok_30d": 1234,
                      "rejected_30d": 56
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:read"
            ]
          },
          {
            "oauth2": [
              "captcha:read"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:read"
          ],
          "mode": "all"
        }
      },
      "post": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-create",
        "summary": "Domain anlegen",
        "description": "Legt eine Domain an. Alle Hosts müssen zur selben registrierbaren Domain gehören (`example.com`, `*.example.com`). Das Secret steht **nur in dieser Antwort**.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesCreateResponse"
                },
                "example": {
                  "success": true,
                  "site": {
                    "id": "uuid",
                    "sitekey": "ek_site_…"
                  },
                  "secret": "ek_secret_…"
                }
              }
            }
          },
          "400": {
            "description": "invalid_host / multiple_domains",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "site_limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaSitesCreateRequest"
              },
              "example": {
                "name": "urbanstudio.de",
                "hosts": [
                  "urbanstudio.de",
                  "*.urbanstudio.de"
                ],
                "mode": "balanced"
              }
            }
          }
        }
      }
    },
    "/api/captcha/sites/bulk": {
      "post": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-bulk",
        "summary": "Viele Domains auf einmal anlegen",
        "description": "Legt bis zu 100 Domains in einem Aufruf an (z. B. für Agenturen). Jeder Eintrag wird einzeln geprüft; die Antwort (207) nennt je Eintrag Erfolg oder Fehler. Die Secrets stehen nur hier.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesBulkResponse"
                },
                "example": {
                  "success": true,
                  "created": 2,
                  "results": [
                    {
                      "index": 0,
                      "ok": true,
                      "site": {
                        "id": "uuid",
                        "sitekey": "ek_site_…"
                      },
                      "secret": "ek_secret_…"
                    },
                    {
                      "index": 1,
                      "ok": false,
                      "error": "site_limit"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid_bulk",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaSitesBulkRequest"
              },
              "example": {
                "sites": [
                  {
                    "name": "kunde-a.de",
                    "hosts": [
                      "kunde-a.de",
                      "*.kunde-a.de"
                    ]
                  },
                  {
                    "name": "kunde-b.de",
                    "hosts": [
                      "kunde-b.de"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/captcha/sites/{id}": {
      "get": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-get",
        "summary": "Domain im Detail",
        "description": "Einstellungen einer Domain einschließlich Seitenschutz und Beobachten-Modus.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain-ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesGetResponse"
                },
                "example": {
                  "success": true,
                  "site": {
                    "id": "uuid",
                    "name": "urbanstudio.de",
                    "hosts": [
                      "urbanstudio.de"
                    ],
                    "mode": "balanced",
                    "observe": false,
                    "gate": {
                      "enabled": false,
                      "ttl_min": 60,
                      "skip": [
                        "/robots.txt"
                      ],
                      "crawlers": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:read"
            ]
          },
          {
            "oauth2": [
              "captcha:read"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:read"
          ],
          "mode": "all"
        }
      },
      "patch": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-update",
        "summary": "Domain ändern",
        "description": "Ändert Name, Hosts, Modus, Token-Gültigkeit, Pausierung, **Beobachten-Modus** (`observe`: bewerten und zählen, aber nie blockieren) und den Seitenschutz (`gate`). Jede Änderung steht im Änderungsprotokoll.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain-ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesUpdateResponse"
                },
                "example": {
                  "success": true,
                  "site": {
                    "id": "uuid",
                    "observe": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Eingabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaSitesUpdateRequest"
              },
              "example": {
                "observe": true
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-delete",
        "summary": "Domain löschen",
        "description": "Löscht die Domain samt Schlüsseln, Regeln und Statistik.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain-ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesDeleteResponse"
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:write"
            ]
          },
          {
            "oauth2": [
              "captcha:write"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:write"
          ],
          "mode": "all"
        }
      }
    },
