    "/api/captcha/sites/{id}/stats": {
      "get": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-stats",
        "summary": "Statistik einer Domain",
        "description": "Zähler je Tag und Kennzahl (challenge, solved, verify_ok, rejected, verify_fail, form_allow/review/block, gate_view/pass, observed_block, form_observed).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "1–90, Standard 30",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaSitesStatsResponse"
                },
                "example": {
                  "success": true,
                  "days": 30,
                  "rows": [
                    {
                      "day": "2026-10-17",
                      "metric": "verify_ok",
                      "n": 120
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:read"
            ]
          },
          {
            "oauth2": [
              "captcha:read"
            ]
          }
        ],
        "x-required-scopes": {
          "scopes": [
            "captcha:read"
          ],
          "mode": "all"
        }
      }
    },
    "/api/captcha/sites/{id}/export.csv": {
      "get": {
        "tags": [
          "EMPEDIAcaptcha (Domains, Regeln, Auswertung)"
        ],
        "operationId": "captcha-sites-export",
        "summary": "Auswertung als CSV",
        "description": "Tageswerte als CSV (Trennzeichen Semikolon, UTF-8 mit BOM).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Domain-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "1–400, Standard 90",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "day;rejected;verify_ok\r\n2026-10-17;3;120",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "captcha:read"
            ]
          },
          {
            "oauth2": [
